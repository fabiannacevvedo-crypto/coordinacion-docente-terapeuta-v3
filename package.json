{
  "name": "sincroaula",
  "version": "1.0.0",
  "description": "SincroAula: Plataforma colaborativa e interactiva para la coordinación entre docente, terapeuta y tutor familiar con enfoque en TDAH",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "concurrently -n \"API,VITE\" -c \"cyan,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "node --watch app.js",
    "dev:frontend": "npm run dev --prefix frontend",
    "build:frontend": "npm run build --prefix frontend",
    "seed": "node src/seeds/seed.js",
    "test": "node test_e2e.js"
  },
  "keywords": [
    "sincroaula",
    "coordinacion",
    "docente",
    "terapeuta",
    "educacion-inclusiva",
    "sequelize",
    "express-validator",
    "react",
    "tdah"
  ],
  "author": "SincroAula - Innovación Neuroeducativa",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.12.0",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
